{
	"name": "n8n-nodes-simgate",
	"version": "0.1.0",
	"description": "Send and receive SMS through your own phone with SimGate",
	"license": "MIT",
	"homepage": "https://simgate.app",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"simgate",
		"sms",
		"sms-gateway",
		"android"
	],
	"author": {
		"name": "Nikola",
		"email": "nikola@viametrics.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/simgate-dev/n8n-nodes-simgate.git"
	},
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SimGateApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SimGate/SimGate.node.js",
			"dist/nodes/SimGate/SimGateTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.44.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
